# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Testing & Linting caches
.pytest_cache/
.ruff_cache/

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Agent metadata
.agents/
.agents/teamwork/

# Visualizers generated by the CLI land in the working directory: ignore the ones at the
# repository root, except the website itself. HTML anywhere else (web/template.html,
# design-system previews, ...) is source and stays tracked.
/*.html
!/index.html

# Node (tests/js uses only built-in modules, but keep installs out of git if added)
node_modules/
